# =====================================================================
# Monitoreo Docum · LinkTic — Variables de entorno
# Copiar estas variables en Vercel → Project → Settings → Environment Variables
# (en Vercel se pegan los valores SIN comillas).
# =====================================================================

# --- Acceso al tablero (token único del Scrum Master) ---
ACCESS_TOKEN="<token-de-acceso>"
# Llave para firmar la cookie de sesión (64 hex). Cambiarla invalida todas las sesiones.
SESSION_SECRET="<openssl rand -hex 32>"

# --- Supabase (proyecto baas-monitoreo-docum) — SOLO servidor ---
SUPABASE_URL="https://klrierizueihrenhcema.supabase.co"
# Dashboard → Project Settings → API Keys → "Secret keys" (sb_secret_...). NUNCA exponer al cliente.
SUPABASE_SECRET_KEY="<sb_secret_...>"

# --- Azure DevOps · Proyecto 348 (solo lectura: Work Items, Project and Team, Analytics) ---
AZURE_348_ORG="LinkTic"
AZURE_348_PROJECT="348 - SGDEA ACUEDUCTO"
# Épicas: 539200 = Certificación CORE · 539569 = Certificación Temáticos
AZURE_348_EPIC_IDS="539200,539569"
AZURE_348_PAT="<pat-solo-lectura>"

# --- Azure DevOps · Proyecto 005 (solo lectura) ---
AZURE_005_ORG="3tcapitalco"
AZURE_005_PROJECT="005 - POSITIVA SGDEA NEW"
# Épicas: 578 = Deuda Técnica y Contractual · 568 = Épica de gestión · 153 = Deuda · 82 = NP - Evolutivos
AZURE_005_EPIC_IDS="578,568,153,82"
AZURE_005_PAT="<pat-solo-lectura>"

# --- SOLO DESARROLLO LOCAL (NO subir a Vercel) ---
# Access token personal de la cuenta Supabase dueña del proyecto (sbp_...).
# Se usa únicamente para aplicar migraciones desde la terminal / agentes.
SUPABASE_ACCESS_TOKEN=""
